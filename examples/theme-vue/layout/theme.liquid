<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Scripts and styles built by Vite (snippet generated by vite-plugin-shopify) %}
    {% render 'vite-tag' with 'theme.ts' %}

    {{ content_for_header }}
  </head>

  <body>
    {% # Data shared by every island: read by the stores in @pelagojs/shopify %}
    {%- capture global_props -%}
      {
        "locale": {
          "language": {{ request.locale.iso_code | json }},
          "country": {{ localization.country.iso_code | json }},
          "currency": {{ cart.currency.iso_code | json }},
          "moneyFormat": {{ shop.money_format | json }},
          "rootUrl": {{ routes.root_url | json }}
        },
        "customer": {%- if customer -%}
          {
            "id": {{ customer.id }},
            "email": {{ customer.email | json }},
            "firstName": {{ customer.first_name | json }},
            "lastName": {{ customer.last_name | json }}
          }
        {%- else -%}
          null
        {%- endif -%},
        "cart": {% render 'cart-json' %},
        "translations": {% render 'pelago-translations' %}
      }
    {%- endcapture -%}
    {% render 'data-island', id: 'global', json: global_props %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
